# Copy to .env and adjust. Never commit .env (it is .gitignored).
#
# Every key below maps 1:1 to a field on torque.config.Settings, or (with the
# TORQUE_POLICY_ prefix) torque.config.PolicyConfig. Unset keys fall back to the
# defaults shown here — the file is documentation of the whole config surface,
# not a required checklist. Secrets are intentionally blank; fill them in .env.
#
# docker compose --profile full up injects the compose-network addresses for
# DATABASE_URL / REDIS_URL / TORQUE_API_HOST itself (see docker-compose.yml);
# the values here are the host / `uv run python -m torque` defaults.

# ── Databases ──────────────────────────────────────────────────────────────
# Primary application database. Host port 5442 = the docker-compose `db`
# service (offset from 5432 to avoid clashing with a local Postgres).
#   in compose: postgresql+psycopg://postgres:postgres@db:5432/torque
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5442/torque

# The test suite's throwaway database — MUST NOT point at DATABASE_URL. The
# suite drops/recreates the `public` schema here on every run. conftest.py
# reads this exact key (falls back to the same default).
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5442/torque_test

# ── Redis (Celery broker transport ONLY — no result backend) ───────────────
# Host port 6389 = the docker-compose `redis` service.
#   in compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6389/0

# ── API process ───────────────────────────────────────────────────────────
# Consumed by `python -m torque` (uvicorn). 127.0.0.1 for host dev; the `api`
# container sets 0.0.0.0 so its published port is reachable.
TORQUE_API_HOST=127.0.0.1
TORQUE_API_PORT=8000

# ── Razorpay webhook verification (Blueprint §2.2 / Decision L) ────────────
# Dashboard-set secrets. Live and Test are distinct and never crossed. The
# endpoint verifies against exactly ONE — the one named by RAZORPAY_WEBHOOK_MODE
# — and fails closed (drops every request) if that secret is unset.
RAZORPAY_WEBHOOK_SECRET_LIVE=
RAZORPAY_WEBHOOK_SECRET_TEST=
RAZORPAY_WEBHOOK_MODE=test

# ── Checkout-abandonment injection (Blueprint §2.6 / Part D item 1) ────────
# HMAC secret for POST /internal/checkout-abandoned/{merchant_id}. Unset → the
# endpoint fails closed.
CHECKOUT_INJECTION_SECRET=

# ── Celery execution mode ────────────────────────────────────────────────
# true runs tasks inline with no broker/worker. Set ONLY by the test harness —
# never in a real deployment.
CELERY_TASK_ALWAYS_EAGER=false

# ── Policy tunables (torque.config.PolicyConfig, prefix TORQUE_POLICY_) ────
# Stated defaults from Blueprint Part E. Override only to tune; the code reads
# these fields so no value is a scattered literal.
#
# Module 2 §2.3 — self-recovery buffer windows.
TORQUE_POLICY_PAYMENT_FAILURE_BUFFER_SECONDS=90
TORQUE_POLICY_SUBSCRIPTION_FAILURE_BUFFER_SECONDS=30
# Module 2 §2.4 — cross-leg dedup lookback.
TORQUE_POLICY_CROSS_LEG_DEDUP_WINDOW_HOURS=2
# Module 6 Part A §5 — Outreach Coordinator cross-leg quiet period.
TORQUE_POLICY_CROSS_LEG_QUIET_PERIOD_HOURS=4
# Module 7 §7.1 — AGENT_ASSISTED vs SELF_RECOVERED attribution window.
TORQUE_POLICY_ATTRIBUTION_WINDOW_HOURS=24
# Module 3 §3.3 — diagnosis confidence routing threshold (T).
TORQUE_POLICY_DIAGNOSIS_CONFIDENCE_THRESHOLD=0.65
# Module 8 §8.2 — warm-start multiplier bounds and the zero-cost divisor floor.
TORQUE_POLICY_WARM_START_CAP_LOW=0.5
TORQUE_POLICY_WARM_START_CAP_HIGH=1.3
TORQUE_POLICY_RECOVERY_SCORE_COST_FLOOR=0.01
# Module 2 §2.5 — systemic detection. spike_multiplier is Decision J (5x);
# baseline_floor_per_min (N), absolute_count_floor (M) and sustain_window are
# UNVERIFIED placeholders (U-04 — no blueprint figure), tuned later.
TORQUE_POLICY_SYSTEMIC_SUSTAIN_WINDOW_MINUTES=10
TORQUE_POLICY_SYSTEMIC_SPIKE_MULTIPLIER=5.0
TORQUE_POLICY_SYSTEMIC_BASELINE_FLOOR_PER_MIN=1.0
TORQUE_POLICY_SYSTEMIC_ABSOLUTE_COUNT_FLOOR=20
TORQUE_POLICY_SYSTEMIC_DETECTION_WINDOW_MINUTES=10
TORQUE_POLICY_SYSTEMIC_BASELINE_DAYS=7
# NACHRetryPolicy §3 — self-imposed representment ceiling (NACH has no NPCI cap).
TORQUE_POLICY_NACH_REPRESENTMENT_CEILING_DEFAULT=3

# ── Test-harness-only overrides (optional; not Settings fields) ────────────
# conftest.py / migrations/env.py read these directly. Leave unset normally.
# TORQUE_TEST_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5442/postgres
# TORQUE_ALEMBIC_URL=postgresql+psycopg://postgres:postgres@localhost:5442/torque
