# Copy to .env and adjust. Never commit .env.

# Primary application database. Port 5442 = the docker-compose `db` service
# (published there to avoid clashing with a local Postgres on 5432).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5442/torque

# Database used by the test suite. Tests create/drop schema here — must NOT
# point at the primary database. conftest.py falls back to this exact value
# if TEST_DATABASE_URL is unset.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5442/torque_test

# Razorpay dashboard-set webhook secrets. Live and Test are distinct and must
# never be crossed (Blueprint v7 Section 2.5 / Decision L). Consumed by the
# HMAC verification helper in Module 2; unused in Milestone 1.
RAZORPAY_WEBHOOK_SECRET_LIVE=
RAZORPAY_WEBHOOK_SECRET_TEST=
